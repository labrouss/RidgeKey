<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- RidgeKey lock-screen agent: runs in each user's GUI session. Installed to /Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.labrouss.ridgekey.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/ridgekey/RidgeKeyAgent.app/Contents/MacOS/ridgekey-agent</string>
  </array>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
